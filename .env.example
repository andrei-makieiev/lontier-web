# Public URL of the site (used for metadata, sitemap and robots).
NEXT_PUBLIC_SITE_URL=https://lontier.com

# ─── Enquiry delivery ───────────────────────────────────────────────
# Without any channel configured, enquiries are only logged on the server.

# 1) Telegram bot (primary). See README → "Enquiry delivery" for the 3-minute setup.
TELEGRAM_BOT_TOKEN=
# Your chat with the bot (positive number) or a group the bot is in (starts with -100…).
TELEGRAM_CHAT_ID=

# 2) Email via Resend (optional written copy). https://resend.com
RESEND_API_KEY=
ENQUIRY_TO=office@lontier.com
ENQUIRY_FROM=Lontier <enquiries@lontier.com>
